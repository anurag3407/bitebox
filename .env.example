# ---------------------------------------------------------------------------
# Application
# APP_ENV=production|staging turns on the insecure-config guard: the web app and
# worker refuse to start with placeholder secrets, demo auth, or a non-https origin.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_ORIGIN=http://localhost:3000
PORT=3000
LOG_LEVEL=info
# Dev only: allow persona tokens (demo_customer, demo_merchant, demo_rider, demo_admin)
# when running a production build locally. Ignored in staging/production.
# AUTH_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Authentication (Clerk). Leave the placeholders to use dev demo personas.
# CLERK_ISSUER is your Frontend API URL (Clerk dashboard → API keys → Advanced).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_for_local_development
CLERK_SECRET_KEY=sk_test_placeholder_for_local_development
CLERK_ISSUER=
# Optional: defaults to ${CLERK_ISSUER}/.well-known/jwks.json
CLERK_JWKS_URL=
# Optional, comma-separated: origins allowed in the token "azp" claim (defaults to APP_ORIGIN)
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SIGNING_SECRET=whsec_placeholder

# ---------------------------------------------------------------------------
# Database (Supabase / PostgreSQL 15+)
# Use the pooled URL for the app and the direct URL for migrations on Supabase.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/startup_dev
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=20
# Tests only ever run against a database whose name contains "test"
TEST_DATABASE_URL=postgresql://localhost:5432/startup_test

# ---------------------------------------------------------------------------
# Upstash Redis (rate limits, live rider locations, menu cache).
# Placeholders fall back to an in-process store (dev only).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://placeholder-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder_token

# ---------------------------------------------------------------------------
# Payments (Razorpay). With placeholder secrets checkout uses a simulated gateway.
# Webhook URL to register: ${APP_ORIGIN}/api/v1/webhooks/razorpay
#   events: payment.captured, order.paid, payment.failed, refund.processed, refund.failed
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# ---------------------------------------------------------------------------
# Maps (Mapbox). Server token: routing + geocoding. Public token: tracking map image.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.placeholder_mapbox_token
MAPBOX_SERVER_TOKEN=sk.placeholder_mapbox_server_token

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
FAST2SMS_API_KEY=placeholder_fast2sms_api_key
FAST2SMS_SENDER_ID=FSTSMS
BREVO_API_KEY=placeholder_brevo_api_key
BREVO_SENDER_EMAIL=support@fooddelivery.local
BREVO_SENDER_NAME=ZomatoFresh
# Web push (PWA order alerts): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@fooddelivery.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Dispatch escalations, refund failures and payment anomalies are emailed here
OPS_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
OTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---------------------------------------------------------------------------
# Deployment (infra/compose)
# ---------------------------------------------------------------------------
TLS_CERT_DIR=/etc/letsencrypt
ACME_WEBROOT=/var/www/certbot
