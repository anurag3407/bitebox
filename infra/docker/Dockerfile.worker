# Durable background worker. Also used as the one-shot migration runner.
# Workspace packages export TypeScript sources, so the runtime uses tsx's loader
# (node --import tsx) instead of a separate compile step.
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/config/package.json ./packages/config/
COPY packages/core/package.json ./packages/core/
COPY packages/database/package.json ./packages/database/
COPY packages/integrations/package.json ./packages/integrations/
COPY packages/api-client/package.json ./packages/api-client/
COPY apps/worker/package.json ./apps/worker/
RUN pnpm install --frozen-lockfile --prod --filter @startup/worker... --filter @startup/database...

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 workergroup && adduser --system --uid 1001 workeruser
COPY --from=deps /app ./
COPY tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/worker/src ./apps/worker/src
COPY apps/worker/tsconfig.json ./apps/worker/
USER workeruser
WORKDIR /app/apps/worker
# SIGTERM drains in-flight jobs (up to 25s); compose gives 30s before SIGKILL
STOPSIGNAL SIGTERM
CMD ["node", "--import", "tsx", "src/main.ts"]
